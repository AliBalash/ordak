PRODUCT_NAME=ordak
PRODUCT_LABEL=اردک 🦆
BROWSER_PLATFORM=auto
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./app/storage/jobs.db

# Keep this false for local Chrome reuse.
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=120
BROWSER_TIMEOUT_MS=180000
BROWSER_ENGINE=chrome
# mac example:
BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux example:
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
# Linux backend attaches to the Chrome instance exposed through this DevTools URL.
BROWSER_REMOTE_DEBUGGING_URL=http://127.0.0.1:9222
# Keep this false if you manage the 9222 Chrome session yourself.
BROWSER_REMOTE_DEBUGGING_AUTO_LAUNCH=false
BROWSER_REMOTE_DEBUGGING_LAUNCH_TIMEOUT_MS=30000
# macOS example:
# BROWSER_REMOTE_DEBUGGING_USER_DATA_DIR=./app/storage/profiles/gemini-login
# Linux dedicated DevTools profile example:
BROWSER_REMOTE_DEBUGGING_USER_DATA_DIR=/home/<your-user>/.config/ordak-chrome
# Update this path for your own macOS account before first run.
BROWSER_USER_DATA_DIR=/Users/<your-user>/Library/Application Support/Google/Chrome
# Linux example:
# BROWSER_USER_DATA_DIR=/home/<your-user>/.config/google-chrome
BROWSER_PROFILE_NAME=Default
BROWSER_PROFILE_DIR=./app/storage/profiles/gemini
BROWSER_LOGIN_PROFILE_DIR=./app/storage/profiles/gemini-login
BROWSER_RUNTIME_ROOT_DIR=./app/storage/profiles/runtime
BROWSER_SCREENSHOT_DIR=./app/storage/screenshots
BROWSER_TRACE_DIR=./app/storage/traces
# Stored user-uploaded panel images
BROWSER_UPLOAD_DIR=./app/storage/uploads
BROWSER_OUTPUT_DIR=./app/storage/outputs
# Debug-only Linux fallback. Leave this off unless you intentionally want the old X11 path.
BROWSER_LINUX_X11_FALLBACK_ENABLED=false

GEMINI_URL=https://gemini.google.com/app
GEMINI_RESPONSE_TIMEOUT_MS=240000
GEMINI_STABLE_RESPONSE_SECONDS=4
CHATGPT_URL=https://chatgpt.com/
# Set this to your ChatGPT Project URL to keep chats isolated per project.
CHATGPT_PROJECT_URL=
CHATGPT_RESPONSE_TIMEOUT_MS=240000
CHATGPT_STABLE_RESPONSE_SECONDS=4

STORAGE_RETENTION_DAYS=14
MAX_OUTPUT_IMAGES_PER_JOB=4
MAX_TRACES=80
MAX_FAILURE_HTML_DUMPS=80

HUMAN_TYPING_ENABLED=false
HUMAN_TYPING_DELAY_MIN_MS=15
HUMAN_TYPING_DELAY_MAX_MS=55
